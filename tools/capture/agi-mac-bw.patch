+// The black and white Macintosh interpreter dithers a cel while drawing it, and unlike the
+// picture its pattern isn't tied to the screen: the pattern row pair is the number of cel
+// rows left to draw (counting down to 1 at the bottom), and the pattern column restarts
+// with every RLE run of the view data. Runs are at most 15 pixels, split from the left
+// (true of every SQ1 view), and mirroring reverses their order. render_BlockMacintoshBW()
+// reads this from the upper bits of the visual screen; bit 7 marks a cel pixel.
+static byte macintoshBWCelPhase(const byte *row, int16 width, int16 x, bool mirrored, uint8 rowsLeft) {
+	int16 start = x, end = x;
+	while (start > 0 && row[start - 1] == row[x])
+		start--;
+	while (end < width - 1 && row[end + 1] == row[x])
+		end++;
+
+	int16 place = (x - start) % 15;
+	if (mirrored) {
+		int16 fromRight = end - x;
+		int16 chunk = fromRight / 15;
+		int16 chunkLen = MIN<int16>(15, end - start + 1 - chunk * 15);
+		place = chunk * 15 + chunkLen - 1 - fromRight;
+	}
+	return 0x80 | ((place & 1) << 6) | ((rowsLeft & 3) << 4);
+}
